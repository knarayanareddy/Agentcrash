# Server-only settings. Copy to a private env file or export before launch.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/saaf

# --- Judgment layer (Jev) -------------------------------------------------
# Without a key the judgment layer fails closed: nothing can be authorized.
TYPESAFE_API_KEY=
# JEV_API_KEY is an alternative to TYPESAFE_API_KEY.

# --- Proposal model (Ticket Lab) ------------------------------------------
# One model call turns an untrusted customer message into a structured refund
# proposal. OpenAI-compatible chat completions. Without a key the Ticket Lab
# falls back to a deterministic offline heuristic, clearly labelled as such.
PROPOSAL_API_KEY=
# PROPOSAL_API_BASE=https://api.openai.com/v1
# PROPOSAL_MODEL=gpt-4o-mini

# --- Demo switches --------------------------------------------------------
# SAAF_DEMO_JUDGMENT=1 substitutes a labelled local stub for the judgment model
# when no key is configured, so the eligible-refund control case can be shown
# offline. The substitution is recorded in the response, the UI and the
# workpaper. Leave unset in any environment you care about.
SAAF_DEMO_JUDGMENT=
# SAAF_HALT_ALL_TOOL_ACTIONS=1 refuses every tool action, including execute_refund.
SAAF_HALT_ALL_TOOL_ACTIONS=
